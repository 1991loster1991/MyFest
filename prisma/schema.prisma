generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReservationStatus {
  PENDING
  APPROVED
  ACTIVATED
  REJECTED
  CHECKED_IN
}

enum OrderStatus {
  PENDING
  DELIVERED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  PAID
  REJECTED
}

enum CatalogType {
  ENTRY
  DRINK
}

enum AdmissionIncidentReason {
  CAPACITY_REACHED
  MISSING_ID
  DRESS_CODE
  SAFETY_CONCERN
  CONDUCT
  OTHER_OBJECTIVE_REASON
}

model Reservation {
  id            String            @id @default(cuid())
  fullName      String
  email         String
  dni           String            @unique
  birthDate     DateTime?         @db.Date
  phone         String
  partySize     Int               @default(1)
  notes         String?
  status        ReservationStatus @default(PENDING)
  entryProductName String         @default("Entrada general (demo)")
  entryPriceCents Int             @default(0)
  paymentStatus PaymentStatus     @default(PENDING)
  paymentReference String?
  paymentConfirmedAt DateTime?
  activatedAt   DateTime?
  qrCode        String?            @unique
  wristbandCode String?            @unique
  checkedInAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  orders        BarOrder[]
  incidents     AdmissionIncident[]
  guests        ReservationGuest[]
  notifications ReservationNotification[]
  eventLoads    EventLoad[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model ReservationGuest {
  id            String      @id @default(cuid())
  reservationId String
  fullName      String
  dni           String      @unique
  birthDate     DateTime    @db.Date
  qrCode        String?     @unique
  wristbandCode String?
  checkedInAt   DateTime?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventLoads    EventLoad[]

  @@index([reservationId])
}

/// Carga de una persona (QR único y permanente) para un evento concreto.
/// El QR se mantiene igual entre eventos: es el carné del cliente.
model EventLoad {
  id                String       @id @default(cuid())
  reservationId     String
  guestId           String?
  personName        String
  dni               String
  qrCode            String
  productName       String       @default("")
  eventDate         String?
  eventPlace        String?
  consumptionItem   String?
  /// PENDING (sin ingreso) · ADMITTED (activado en puerta) · REJECTED · DELIVERED
  accessStatus      String       @default("PENDING")
  rejectionReason   String?
  admittedAt        DateTime?
  deliveredAt       DateTime?
  deactivatedAt     DateTime?
  deactivatedBy     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  reservation       Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest             ReservationGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([reservationId, guestId])
  @@index([accessStatus, createdAt])
  @@index([dni])
}

model ReservationNotification {
  id            String      @id @default(cuid())
  reservationId String
  kind          String
  message       String
  whatsappSent  Boolean     @default(false)
  whatsappError String?
  /// Comprobante adjuntado por el cliente (imagen o PDF guardado como data URL).
  attachmentUrl   String?
  attachmentName  String?
  emailSent     Boolean     @default(false)
  emailError    String?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model BarOrder {
  id            String      @id @default(cuid())
  reservationId String
  itemName      String
  quantity      Int         @default(1)
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PAID)
  paymentReference String?
  unitPriceCents Int         @default(0)
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  reservation  Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model CatalogProduct {
  id          String      @id @default(cuid())
  type        CatalogType
  name        String
  description String?
  priceCents  Int         @default(0)
  active      Boolean     @default(true)
  isDemo      Boolean     @default(true)
  eventDate   String?
  eventPlace  String?
  /// Consumición incluida con la entrada de este evento (se entrega en barra).
  includedItem String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([type, name])
  @@index([type, active])
}

model AdmissionIncident {
  id            String                 @id @default(cuid())
  reservationId String?
  reason        AdmissionIncidentReason
  details       String?
  operatorRole  String
  createdAt     DateTime               @default(now())
  reservation   Reservation?           @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([createdAt, reason])
}

model StaffAdmin {
  id           String   @id @default(cuid())
  name         String
  alias        String   @unique(map: "StaffAdmin_email_key") @map("email")
  passwordHash String
  sectors      String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, createdAt])
}

model EventPeriod {
  id        String    @id @default(cuid())
  name      String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  active    Boolean   @default(false)
  /// Habilita el formulario público de pre-reserva para el evento actual.
  preReservaOpen Boolean @default(false)
  createdAt DateTime  @default(now())

  @@index([active, startedAt])
}
